# Convex — `npx convex dev` writes these (local: CONVEX_AGENT_MODE=anonymous npx convex dev)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk — https://dashboard.clerk.com → API Keys (leave blank in dev to use Clerk keyless mode)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set on the Convex deployment (not in .env.local):
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-app>.clerk.accounts.dev
# Create a "convex" JWT template in Clerk with `email` and `email_verified` claims.
